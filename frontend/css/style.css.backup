* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: #f5f7fb;
    color: #172033;
}

button {
    font-family: inherit;
}

.app {
    display: flex;
    min-height: 100vh;
}


/* ================= SIDEBAR ================= */

.sidebar {
    width: 250px;
    min-height: 100vh;

    background: #111827;
    color: white;

    display: flex;
    flex-direction: column;

    padding: 24px 16px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 0 10px 30px;
}

.brand-icon {
    width: 42px;
    height: 42px;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #2563eb;

    font-size: 20px;
}

.brand h1 {
    font-size: 16px;
}

.brand span {
    font-size: 11px;
    color: #9ca3af;
}


.navigation {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.nav-item {
    width: 100%;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 14px;

    border: none;
    border-radius: 8px;

    background: transparent;
    color: #9ca3af;

    cursor: pointer;

    text-align: left;

    font-size: 14px;
}

.nav-item:hover {
    background: #1f2937;
    color: white;
}

.nav-item.active {
    background: #2563eb;
    color: white;
}

.sidebar-bottom {
    margin-top: auto;
}


/* ================= MAIN ================= */

.main {
    flex: 1;
    min-width: 0;
}


/* ================= TOPBAR ================= */

.topbar {
    height: 82px;

    background: white;

    border-bottom: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 32px;
}

.topbar h2 {
    font-size: 22px;
}

.topbar p {
    margin-top: 3px;

    color: #6b7280;

    font-size: 13px;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 8px;

    font-size: 13px;

    color: #374151;
}

.status-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #22c55e;
}


/* ================= CONTENT ================= */

.content {
    padding: 28px 32px;
}


/* ================= STAT CARDS ================= */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 22px;
}

.stat-card {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    padding: 20px;

    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 44px;
    height: 44px;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;
}

.tracker-icon {
    background: #eff6ff;
    color: #2563eb;
}

.online-icon {
    background: #ecfdf5;
    color: #16a34a;
}

.alert-icon {
    background: #fff7ed;
    color: #ea580c;
}

.battery-icon {
    background: #f0fdf4;
    color: #16a34a;
}

.stat-label {
    display: block;

    color: #6b7280;

    font-size: 12px;

    margin-bottom: 4px;
}

.stat-card strong {
    font-size: 24px;
}


/* ================= PANELS ================= */

.dashboard-grid {
    display: grid;

    grid-template-columns:
        minmax(0, 2fr)
        minmax(280px, 1fr);

    gap: 20px;

    margin-bottom: 20px;
}

.panel {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    overflow: hidden;
}

.panel-header {
    min-height: 70px;

    padding: 16px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #e5e7eb;
}

.panel-header h3 {
    font-size: 15px;
}

.panel-header span {
    display: block;

    color: #6b7280;

    font-size: 11px;

    margin-top: 4px;
}

.live-badge {
    display: inline-block !important;

    padding: 5px 9px;

    border-radius: 5px;

    background: #ecfdf5;

    color: #15803d !important;

    font-size: 10px !important;

    font-weight: 600;
}


/* ================= MAP ================= */

#map {
    width: 100%;
    height: 430px;
}


/* ================= TRACKERS ================= */

#tracker-list {
    padding: 10px;
}

.tracker-item {
    padding: 15px;

    border-bottom: 1px solid #f0f0f0;
}

.tracker-item:last-child {
    border-bottom: none;
}

.tracker-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.tracker-name strong {
    font-size: 14px;
}

.tracker-device {
    color: #6b7280;

    font-size: 11px;

    margin-top: 3px;
}

.tracker-status {
    margin-top: 12px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 8px;
}

.status-item {
    padding: 8px;

    background: #f9fafb;

    border-radius: 6px;
}

.status-item span {
    display: block;

    color: #6b7280;

    font-size: 10px;
}

.status-item strong {
    display: block;

    margin-top: 2px;

    font-size: 12px;
}


/* ================= ALERTS ================= */

.alerts-panel {
    margin-bottom: 20px;
}

#alerts-list {
    padding: 5px 20px;
}

.alert-item {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 14px 0;

    border-bottom: 1px solid #f0f0f0;
}

.alert-item:last-child {
    border-bottom: none;
}

.alert-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.alert-icon-small {
    width: 34px;
    height: 34px;

    border-radius: 8px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fef2f2;

    color: #dc2626;
}

.alert-title {
    font-size: 13px;
    font-weight: 600;
}

.alert-description {
    margin-top: 3px;

    color: #6b7280;

    font-size: 11px;
}

.alert-status {
    padding: 4px 8px;

    border-radius: 5px;

    background: #fef2f2;

    color: #dc2626;

    font-size: 10px;

    font-weight: 600;
}

.alert-status.resolved {
    background: #ecfdf5;
    color: #15803d;
}


/* ================= EMPTY ================= */

.empty-state {
    padding: 30px;

    text-align: center;

    color: #9ca3af;

    font-size: 13px;
}


/* ================= BUTTON ================= */

.refresh-button {
    padding: 7px 12px;

    border: 1px solid #d1d5db;

    border-radius: 6px;

    background: white;

    cursor: pointer;

    font-size: 11px;
}

.refresh-button:hover {
    background: #f9fafb;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 1100px) {

    .stats-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}


@media (max-width: 700px) {

    .sidebar {
        width: 70px;

        padding: 20px 10px;
    }

    .brand div:last-child {
        display: none;
    }

    .nav-item span:last-child {
        display: none;
    }

    .nav-item {
        justify-content: center;
    }

    .content {
        padding: 18px;
    }

    .topbar {
        padding: 0 18px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }
}