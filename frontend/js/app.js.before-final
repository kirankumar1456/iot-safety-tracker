const API_BASE = "/api";

let map;
let fullMap;

let markers = {};
let fullMapMarkers = {};


// ======================================================
// INITIALIZE DASHBOARD MAP
// ======================================================

function initializeMap() {

    const mapElement = document.getElementById("map");

    if (!mapElement) {
        return;
    }

    if (map) {
        map.invalidateSize();
        return;
    }

    map = L.map("map").setView(
        [22.3072, 73.1812],
        13
    );

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                "&copy; OpenStreetMap contributors"
        }
    ).addTo(map);
}


// ======================================================
// INITIALIZE FULL LIVE MAP
// ======================================================

function initializeFullMap() {

    const mapElement =
        document.getElementById("full-map");

    if (!mapElement) {
        return;
    }

    if (fullMap) {
        setTimeout(() => {
            fullMap.invalidateSize();
        }, 100);

        return;
    }

    fullMap = L.map("full-map").setView(
        [22.3072, 73.1812],
        13
    );

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                "&copy; OpenStreetMap contributors"
        }
    ).addTo(fullMap);
}


// ======================================================
// LOAD TRACKERS
// ======================================================

async function loadTrackers() {

    try {

        const response = await fetch(
            `${API_BASE}/trackers`
        );

        if (!response.ok) {

            throw new Error(
                "Failed to load trackers"
            );
        }

        const trackers =
            await response.json();

        updateTrackerStats(trackers);

        displayTrackers(trackers);

        updateMap(trackers);

        // Update full live map if initialized
        if (fullMap) {
            updateFullMap(trackers);
        }

        // Update tracker management page
        displayTrackerManagement(
            trackers
        );

    } catch (error) {

        console.error(
            "Tracker loading error:",
            error
        );
    }
}


// ======================================================
// UPDATE TRACKER STATISTICS
// ======================================================

function updateTrackerStats(trackers) {

    const total =
        trackers.length;

    const online =
        trackers.filter(
            tracker =>
                tracker.status === "online"
        ).length;

    const batteries =
        trackers
            .map(
                tracker =>
                    Number(tracker.battery)
            )
            .filter(
                battery =>
                    !Number.isNaN(battery)
            );

    let averageBattery = 0;

    if (batteries.length > 0) {

        averageBattery =
            batteries.reduce(
                (sum, battery) =>
                    sum + battery,
                0
            ) / batteries.length;
    }

    const totalElement =
        document.getElementById(
            "total-trackers"
        );

    const onlineElement =
        document.getElementById(
            "online-trackers"
        );

    const batteryElement =
        document.getElementById(
            "average-battery"
        );

    if (totalElement) {
        totalElement.textContent =
            total;
    }

    if (onlineElement) {
        onlineElement.textContent =
            online;
    }

    if (batteryElement) {

        batteryElement.textContent =
            `${Math.round(
                averageBattery
            )}%`;
    }
}


// ======================================================
// DISPLAY DASHBOARD TRACKERS
// ======================================================

function displayTrackers(trackers) {

    const container =
        document.getElementById(
            "tracker-list"
        );

    if (!container) {
        return;
    }

    if (trackers.length === 0) {

        container.innerHTML = `
            <div class="empty-state">
                No trackers available
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    trackers.forEach(
        tracker => {

            const item =
                document.createElement(
                    "div"
                );

            item.className =
                "tracker-item";

            item.innerHTML = `

                <div class="tracker-name">

                    <strong>
                        ${escapeHtml(
                            tracker.name
                        )}
                    </strong>

                    <span>
                        ${
                            tracker.status ===
                            "online"
                                ? "🟢"
                                : "⚪"
                        }
                    </span>

                </div>

                <div class="tracker-device">

                    ${escapeHtml(
                        tracker.device_id
                    )}

                </div>

                <div class="tracker-status">

                    <div class="status-item">

                        <span>Battery</span>

                        <strong>
                            ${tracker.battery ?? 0}%
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>GPS</span>

                        <strong>
                            ${escapeHtml(
                                tracker.gps_status ||
                                "unknown"
                            )}
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>Network</span>

                        <strong>
                            ${escapeHtml(
                                tracker.wifi_status ||
                                "unknown"
                            )}
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>Assigned</span>

                        <strong>
                            ${escapeHtml(
                                tracker.assigned_person ||
                                "Unassigned"
                            )}
                        </strong>

                    </div>

                </div>
            `;

            container.appendChild(
                item
            );
        }
    );
}


// ======================================================
// DISPLAY TRACKER MANAGEMENT PAGE
// ======================================================

