                            )}
                        </strong>

                    </div>

                </div>
            `;

            container.appendChild(
                item
            );
        }
    );
}


// ======================================================
// UPDATE DASHBOARD MAP
// ======================================================

async function updateMap(trackers) {

    if (!map) {
        return;
    }

    let firstLocation = null;

    for (const tracker of trackers) {

        try {

            const response =
                await fetch(
                    `${API_BASE}/telemetry/${encodeURIComponent(
                        tracker.device_id
                    )}`
                );

            if (!response.ok) {
                continue;
            }

            const telemetry =
                await response.json();

            if (
                !telemetry ||
                telemetry.length === 0
            ) {
                continue;
            }

            const latest =
                telemetry[0];

            if (
                latest.latitude === null ||
                latest.longitude === null ||
                latest.latitude === undefined ||
                latest.longitude === undefined
            ) {
                continue;
            }

            const latitude =
                Number(
                    latest.latitude
                );

            const longitude =
                Number(
                    latest.longitude
                );

            if (
                Number.isNaN(latitude) ||
                Number.isNaN(longitude)
            ) {
                continue;
            }

            if (!firstLocation) {

                firstLocation = [
                    latitude,
                    longitude
                ];
            }

            const popup = `

                <strong>
                    ${escapeHtml(
                        tracker.name
                    )}
                </strong>

                <br>

                Device:
                ${escapeHtml(
                    tracker.device_id
                )}

                <br>

                Battery:
                ${tracker.battery ?? 0}%

                <br>

                GPS:
                ${escapeHtml(
                    tracker.gps_status ||
                    "unknown"
                )}

                <br>

                Network:
                ${escapeHtml(
                    tracker.wifi_status ||
                    "unknown"
                )}

            `;

            if (
                markers[
                    tracker.device_id
                ]
            ) {

                markers[
                    tracker.device_id
                ].setLatLng([
                    latitude,
                    longitude
                ]);

                markers[
                    tracker.device_id
                ].bindPopup(
                    popup
                );

            } else {

                markers[
                    tracker.device_id
                ] =
                    L.marker([
                        latitude,
                        longitude
                    ])
                    .addTo(map)
                    .bindPopup(
                        popup
                    );
            }

        } catch (error) {

            console.error(
                `Map telemetry error for ${tracker.device_id}:`,
                error
            );
        }
    }

    if (firstLocation) {

        map.setView(
            firstLocation,
            15
        );
    }
}


// ======================================================
// UPDATE FULL LIVE MAP
// ======================================================

async function updateFullMap(
    trackers
) {

    if (!fullMap) {
        return;
    }

    const locations = [];

    for (const tracker of trackers) {

        try {

            const response =
                await fetch(
                    `${API_BASE}/telemetry/${encodeURIComponent(
                        tracker.device_id
                    )}`
                );

            if (!response.ok) {
                continue;
            }

            const telemetry =
                await response.json();

            if (
                !telemetry ||
                telemetry.length === 0
            ) {
                continue;
            }

            const latest =
                telemetry[0];

            if (
                latest.latitude === null ||
                latest.longitude === null ||
                latest.latitude === undefined ||
                latest.longitude === undefined
            ) {
                continue;
            }

            const latitude =
                Number(
                    latest.latitude
                );

            const longitude =
                Number(
                    latest.longitude
                );

            if (
                Number.isNaN(latitude) ||
                Number.isNaN(longitude)
            ) {
                continue;
            }

            locations.push([
                latitude,
                longitude
            ]);

            const statusIcon =
                tracker.status === "online"
                    ? "🟢"
                    : "⚪";

            const popup = `

                <div style="min-width:220px">

                    <strong
                        style="font-size:15px"
                    >
                        ${escapeHtml(
                            tracker.name
                        )}
                    </strong>

                    <br><br>

                    <strong>
                        Device:
                    </strong>

                    ${escapeHtml(
                        tracker.device_id
                    )}

                    <br>

                    <strong>
                        Status:
                    </strong>

                    ${statusIcon}

                    ${escapeHtml(
                        tracker.status ||
                        "unknown"
                    )}

                    <br>

                    <strong>
                        Battery:
                    </strong>

                    ${tracker.battery ?? 0}%

                    <br>

                    <strong>
                        GPS:
                    </strong>

                    ${escapeHtml(
                        tracker.gps_status ||
                        "unknown"
                    )}

                    <br>

                    <strong>
                        Network:
                    </strong>

                    ${escapeHtml(
                        tracker.wifi_status ||
                        "unknown"
                    )}

                    <br><br>

                    <strong>
                        Latitude:
                    </strong>

                    ${latitude.toFixed(6)}

                    <br>

                    <strong>
                        Longitude:
                    </strong>

                    ${longitude.toFixed(6)}

                </div>

            `;

            if (
                fullMapMarkers[
                    tracker.device_id
                ]
            ) {

                fullMapMarkers[
                    tracker.device_id
                ].setLatLng([
                    latitude,
                    longitude
                ]);

                fullMapMarkers[
                    tracker.device_id
                ].bindPopup(
                    popup
                );

            } else {

                fullMapMarkers[
                    tracker.device_id
                ] =
                    L.marker([
                        latitude,
                        longitude
                    ])
                    .addTo(fullMap)
                    .bindPopup(
                        popup
                    );
            }

        } catch (error) {

            console.error(
                `Full map telemetry error for ${tracker.device_id}:`,
                error
            );
        }
    }

    if (locations.length > 0) {

        const bounds =
            L.latLngBounds(
                locations
            );

        fullMap.fitBounds(
            bounds,
            {
                padding: [
                    40,
                    40
                ],
                maxZoom: 15
            }
        );
    }
}


// ======================================================
// LOAD ALERTS
// ======================================================

async function loadAlerts() {

    try {

        const response =
            await fetch(
                `${API_BASE}/alerts`
            );

        if (!response.ok) {

            throw new Error(
                "Failed to load alerts"
            );
        }

        const alerts =
            await response.json();

        displayAlerts(alerts);

        displayAllAlerts(alerts);

        updateAlertCount(alerts);

    } catch (error) {

        console.error(
            "Alert loading error:",
            error
        );
    }
}


// ======================================================
// DISPLAY DASHBOARD ALERTS
// ======================================================

function displayAlerts(alerts) {

    const container =
        document.getElementById(
            "alerts-list"
        );

    if (!container) {
        return;
    }

    if (
        !alerts ||
        alerts.length === 0
    ) {

        container.innerHTML = `
            <div class="empty-state">
                No alerts
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    alerts
        .slice(0, 10)
        .forEach(
            alert => {

                const item =
                    document.createElement(
                        "div"
                    );

                item.className =
                    "alert-item";

                const resolvedClass =
                    alert.status ===
                    "resolved"
                        ? "resolved"
                        : "";

                item.innerHTML = `

                    <div class="alert-info">

                        <div
                            class="alert-icon-small"
                        >
                            ⚠
                        </div>

                        <div>

                            <div
                                class="alert-title"
                            >
                                ${escapeHtml(
                                    alert.alert_type
                                )}
                            </div>

                            <div
                                class="alert-description"
                            >
                                ${escapeHtml(
                                    alert.message
                                )}

                                —

                                ${escapeHtml(
                                    alert.device_id
                                )}
                            </div>

                        </div>

                    </div>

                    <span
                        class="alert-status ${resolvedClass}"
                    >
                        ${escapeHtml(
                            alert.status
                        )}
                    </span>

                `;

                container.appendChild(
                    item
                );
            }
        );
}


