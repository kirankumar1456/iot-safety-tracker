// ======================================================
// UPDATE ALERT COUNT
// ======================================================

function updateAlertCount(
    alerts
) {

    const activeAlerts =
        alerts.filter(
            alert =>
                alert.status ===
                "active"
        ).length;

    const element =
        document.getElementById(
            "active-alerts"
        );

    if (element) {

        element.textContent =
            activeAlerts;
    }
}


// ======================================================
// HTML ESCAPE
// ======================================================

function escapeHtml(value) {

    if (
        value === null ||
        value === undefined
    ) {
        return "";
    }

    return String(value)
        .replaceAll(
            "&",
            "&amp;"
        )
        .replaceAll(
            "<",
            "&lt;"
        )
        .replaceAll(
            ">",
            "&gt;"
        )
        .replaceAll(
            '"',
            "&quot;"
        )
        .replaceAll(
            "'",
            "&#039;"
        );
}


// ======================================================
// PAGE NAVIGATION
// ======================================================
// ======================================================
// HISTORY - LOAD TRACKERS
// ======================================================

async function loadHistoryTrackers() {

    const container =
        document.getElementById("history-list");

    if (!container) {
        return;
    }

    try {

        const response = await fetch(
            `${API_BASE}/trackers`
        );

        if (!response.ok) {
            throw new Error(
                "Failed to load trackers"
            );
        }

        const trackers = await response.json();

        if (!trackers || trackers.length === 0) {

            container.innerHTML = `
                <div class="empty-state">
                    No trackers available.
                </div>
            `;

            return;
        }

        let html = `
            <div class="history-controls">

                <label for="history-tracker-select">
                    Select Tracker
                </label>

                <select id="history-tracker-select">

                    <option value="">
                        Select a tracker
                    </option>
        `;

        trackers.forEach(tracker => {

            html += `
                <option value="${escapeHtml(
                    tracker.device_id
                )}">
                    ${escapeHtml(
                        tracker.name ||
                        tracker.device_id
                    )}
                    -
                    ${escapeHtml(
                        tracker.device_id
                    )}
                </option>
            `;

        });

        html += `
                </select>

                <button
                    type="button"
                    class="refresh-button"
                    id="history-refresh-button"
                >
                    Refresh
                </button>

            </div>

            <div id="history-table-container">

                <div class="empty-state">
                    Select a tracker to view telemetry history.
                </div>

            </div>
        `;

        container.innerHTML = html;

        const selector =
            document.getElementById(
                "history-tracker-select"
            );

        if (selector) {

            selector.addEventListener(
                "change",
                () => {

                    if (selector.value) {

                        loadHistory(
                            selector.value
                        );

                    } else {

                        const tableContainer =
                            document.getElementById(
                                "history-table-container"
                            );

                        if (tableContainer) {

                            tableContainer.innerHTML = `
                                <div class="empty-state">
                                    Select a tracker to view telemetry history.
                                </div>
                            `;

                        }

                    }

                }
            );

        }

        const refreshButton =
            document.getElementById(
                "history-refresh-button"
            );

        if (refreshButton) {

            refreshButton.addEventListener(
                "click",
                loadHistoryTrackers
            );

        }

    } catch (error) {

        console.error(
            "History tracker loading error:",
            error
        );

        container.innerHTML = `
            <div class="empty-state">
                Failed to load trackers.
            </div>
        `;

    }
}


// ======================================================
// HISTORY - LOAD TELEMETRY
// ======================================================

async function loadHistory(deviceId) {

    const container =
        document.getElementById(
            "history-table-container"
        );

    if (!container) {
        return;
    }

    container.innerHTML = `
        <div class="empty-state">
            Loading telemetry history...
        </div>
    `;

    try {

        const response = await fetch(
            `${API_BASE}/telemetry/${encodeURIComponent(
                deviceId
            )}`
        );

        if (!response.ok) {

            throw new Error(
                "Failed to load telemetry"
            );

        }

        const telemetry =
            await response.json();

        if (
            !telemetry ||
            telemetry.length === 0
        ) {

            container.innerHTML = `
                <div class="empty-state">
                    No telemetry records found
                    for this tracker.
                </div>
            `;

            return;
        }

        let html = `
            <div class="history-table-wrapper">

                <table class="history-table">

                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                            <th>Accuracy</th>
                            <th>Battery</th>
                            <th>GPS</th>
                            <th>Wi-Fi</th>
                            <th>SOS</th>
                        </tr>
                    </thead>

                    <tbody>
        `;

        telemetry.forEach(record => {

            const latitude =
                record.latitude !== null &&
                record.latitude !== undefined
                    ? Number(
                        record.latitude
                    ).toFixed(6)
                    : "N/A";

            const longitude =
                record.longitude !== null &&
                record.longitude !== undefined
                    ? Number(
                        record.longitude
                    ).toFixed(6)
                    : "N/A";

            const accuracy =
                record.accuracy !== null &&
                record.accuracy !== undefined
                    ? `${Number(
                        record.accuracy
                    ).toFixed(1)} m`
                    : "N/A";

            const battery =
                record.battery !== null &&
                record.battery !== undefined
                    ? `${Number(
                        record.battery
                    ).toFixed(0)}%`
                    : "N/A";

            html += `
                <tr>

                    <td>
                        ${escapeHtml(
                            formatTelemetryTimestamp(
                                record.timestamp
                            )
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            latitude
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            longitude
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            accuracy
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            battery
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            record.gps_status ||
                            "unknown"
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            record.wifi_status ||
                            "unknown"
                        )}
                    </td>

                    <td>
                        ${
                            record.sos
                                ? "🚨 YES"
                                : "No"
                        }
                    </td>

                </tr>
            `;

        });

        html += `
                    </tbody>

                </table>

            </div>

            <div class="history-record-count">

                Showing
                ${telemetry.length}
                telemetry record${
                    telemetry.length === 1
                        ? ""
                        : "s"
                }

            </div>
        `;

        container.innerHTML = html;

    } catch (error) {

        console.error(
            "Telemetry history error:",
            error
        );

        container.innerHTML = `
            <div class="empty-state">
                Failed to load telemetry history.
            </div>
        `;

    }
}


// ======================================================
// HISTORY - FORMAT TIMESTAMP
// ======================================================

function formatTelemetryTimestamp(timestamp) {

    if (!timestamp) {
        return "N/A";
    }

    const date =
        new Date(timestamp);

    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return String(timestamp);

    }

    return date.toLocaleString(
        "en-IN",
        {
            year: "numeric",
            month: "short",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        }
    );
}
// ======================================================
// PAGE NAVIGATION
// ======================================================

function showPage(pageName) {

    const pages = document.querySelectorAll(
        ".page-content"
    );

    const navItems = document.querySelectorAll(
        ".nav-item[data-page]"
    );

    // Hide all pages
    pages.forEach(page => {
        page.classList.add("hidden");
    });

    // Remove active state from navigation
    navItems.forEach(item => {
        item.classList.remove("active");
    });

    // Show selected page
    const selectedPage = document.getElementById(
        `page-${pageName}`
    );

    if (selectedPage) {
        selectedPage.classList.remove("hidden");
    }

    // Activate selected navigation button
    const selectedNav = document.querySelector(
        `.nav-item[data-page="${pageName}"]`
    );

    if (selectedNav) {
        selectedNav.classList.add("active");
    }

    // ==================================================
    // TOP BAR
    // ==================================================

    const titles = {
        dashboard: "Dashboard",
        trackers: "Tracker Management",
        map: "Live Map",
        alerts: "Safety Alerts",
        history: "Telemetry History"
    };

    const descriptions = {
        dashboard:
            "Real-time safety monitoring",

        trackers:
            "Monitor all registered IoT safety trackers.",

        map:
            "Real-time location of all active trackers.",

        alerts:
            "Monitor active and historical safety events.",

        history:
            "Historical GPS and tracker telemetry data."
    };

    const titleElement = document.querySelector(
        ".topbar h2"
    );

    const descriptionElement = document.querySelector(
        ".topbar p"
    );

    if (titleElement) {
        titleElement.textContent =
            titles[pageName] || "Dashboard";
    }

    if (descriptionElement) {
        descriptionElement.textContent =
            descriptions[pageName] ||
            "Real-time safety monitoring";
    }

    // ==================================================
    // TRACKERS PAGE
    // ==================================================

    if (pageName === "trackers") {

        loadTrackers();

        setTimeout(() => {

            // loadTrackers() already fetches the
            // tracker data. This ensures the
            // management page gets populated.

            const managementContainer =
                document.getElementById(
                    "tracker-management-list"
                );

            if (
                managementContainer &&
                window.lastTrackers
            ) {
                displayTrackerManagement(
                    window.lastTrackers
                );
            }

        }, 100);
    }

    // ==================================================
    // LIVE MAP PAGE
    // ==================================================

    if (pageName === "map") {

        initializeFullMap();

        setTimeout(() => {

            if (fullMap) {
                fullMap.invalidateSize();
            }

            loadTrackers();

        }, 300);
    }

    // ==================================================
    // ALERTS PAGE
    // ==================================================

    if (pageName === "alerts") {

        loadAlerts();

        setTimeout(() => {

            const alertsContainer =
                document.getElementById(
                    "all-alerts-list"
                );

            if (
                alertsContainer &&
                window.lastAlerts
            ) {
                displayAllAlerts(
                    window.lastAlerts
                );
            }

        }, 100);
    }

    // ==================================================
    // HISTORY PAGE
    // ==================================================

    if (pageName === "history") {

        loadHistoryTrackers();
    }
}

// ======================================================
// NAVIGATION EVENTS
// ======================================================

function initializeNavigation() {

    const navItems =
        document.querySelectorAll(
            ".nav-item[data-page]"
        );

    navItems.forEach(
        button => {

            button.addEventListener(
                "click",
                () => {

                    const page =
                        button.dataset.page;

                    if (page) {

                        showPage(
                            page
                        );
                    }
                }
            );
        }
    );
}


// ======================================================
// INITIALIZE APPLICATION
// ======================================================

document.addEventListener(
    "DOMContentLoaded",
    () => {

        // Initialize navigation
        initializeNavigation();


        // Initialize dashboard map
        initializeMap();


        // Load initial data
        loadTrackers();

        loadAlerts();


        // ==================================================
        // AUTO REFRESH
        // ==================================================

        setInterval(
            () => {

                loadTrackers();

            },
            10000
        );


        setInterval(
            () => {

                loadAlerts();

            },
            10000
        );

    }
);