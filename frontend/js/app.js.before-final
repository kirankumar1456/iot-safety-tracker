        return;
    }

    container.innerHTML = "";

    trackers.forEach(
        tracker => {

            const item =
                document.createElement(
                    "div"
                );

            item.className =
                "tracker-item";

            item.innerHTML = `

                <div class="tracker-name">

                    <strong>
                        ${escapeHtml(
                            tracker.name
                        )}
                    </strong>

                    <span>

                        ${
                            tracker.status ===
                            "online"
                                ? "🟢 Online"
                                : "⚪ Offline"
                        }

                    </span>

                </div>

                <div class="tracker-device">

                    Device ID:
                    ${escapeHtml(
                        tracker.device_id
                    )}

                </div>

                <div class="tracker-status">

                    <div class="status-item">

                        <span>Battery</span>

                        <strong>
                            ${tracker.battery ?? 0}%
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>GPS</span>

                        <strong>
                            ${escapeHtml(
                                tracker.gps_status ||
                                "unknown"
                            )}
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>Network</span>

                        <strong>
                            ${escapeHtml(
                                tracker.wifi_status ||
                                "unknown"
                            )}
                        </strong>

                    </div>

                    <div class="status-item">

                        <span>Assigned Person</span>

                        <strong>
                            ${escapeHtml(
                                tracker.assigned_person ||
