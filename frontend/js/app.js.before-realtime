// ======================================================
// IoT SAFETY TRACKER - FRONTEND APPLICATION
// ======================================================

const API_BASE = "/api";

let map = null;
let fullMap = null;

let markers = {};
let fullMapMarkers = {};


// ======================================================
// UTILITY
// ======================================================

function escapeHtml(value) {
    if (value === null || value === undefined) {
        return "";
    }

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

// ======================================================
// MAP CONFIGURATION
// ======================================================

const DEFAULT_MAP_CENTER = [22.3072, 73.1812];
const DEFAULT_MAP_ZOOM = 13;


// ======================================================
// CREATE TRACKER ICON
// ======================================================

function createTrackerIcon(tracker) {

    const status =
        String(tracker.status || "offline").toLowerCase();

    const isOnline = status === "online";

    const battery =
        Number(tracker.battery);

    let batteryClass = "battery-normal";

    if (!Number.isNaN(battery)) {

        if (battery <= 20) {
            batteryClass = "battery-low";
        } else if (battery <= 50) {
            batteryClass = "battery-medium";
        }
    }

    const html = `
        <div class="tracker-map-marker
            ${isOnline ? "tracker-online" : "tracker-offline"}
            ${batteryClass}">

            <div class="tracker-marker-pulse"></div>

            <div class="tracker-marker-core">
                🛡
            </div>

        </div>
    `;

    return L.divIcon({

        className: "custom-tracker-icon",

        html: html,

        iconSize: [46, 46],

        iconAnchor: [23, 23],

        popupAnchor: [0, -23]

    });
}


// ======================================================
// DASHBOARD MAP
// ======================================================

function initializeMap() {

    const mapElement =
        document.getElementById("map");

    if (!mapElement) {
        return;
    }

    if (map) {

        setTimeout(() => {

            map.invalidateSize();

        }, 100);

        return;
    }

    map = L.map("map", {

        zoomControl: true,

        attributionControl: true

    }).setView(

        DEFAULT_MAP_CENTER,

        DEFAULT_MAP_ZOOM

    );

    L.tileLayer(

        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",

        {

            maxZoom: 19,

            attribution:
                "&copy; OpenStreetMap contributors"

        }

    ).addTo(map);
}


// ======================================================
// FULL LIVE MAP
// ======================================================

function initializeFullMap() {

    const mapElement =
        document.getElementById("full-map");

    if (!mapElement) {
        return;
    }

    if (fullMap) {

        setTimeout(() => {

            fullMap.invalidateSize();

        }, 100);

        return;
    }

    fullMap = L.map("full-map", {

        zoomControl: true,

        attributionControl: true

    }).setView(

        DEFAULT_MAP_CENTER,

        DEFAULT_MAP_ZOOM

    );

    L.tileLayer(

        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",

        {

            maxZoom: 19,

            attribution:
                "&copy; OpenStreetMap contributors"

        }

    ).addTo(fullMap);
}


// ======================================================
// LOAD TRACKERS
// ======================================================

async function loadTrackers() {

    try {

        const response =
            await fetch(`${API_BASE}/trackers`);

        if (!response.ok) {

            throw new Error(
                "Failed to load trackers"
            );
        }

        const trackers =
            await response.json();

        updateDashboardStats(trackers);

        displayTrackerManagement(trackers);

        updateDashboardMap(trackers);

        updateFullMap(trackers);

    } catch (error) {

        console.error(
            "Tracker loading error:",
            error
        );
    }
}


// ======================================================
// DASHBOARD STATISTICS
// ======================================================

function updateDashboardStats(trackers) {

    if (!Array.isArray(trackers)) {
        return;
    }

    const total =
        trackers.length;

    const online =
        trackers.filter(
            tracker =>
                tracker.status &&
                tracker.status.toLowerCase() === "online"
        ).length;

    const batteries =
        trackers

            .map(
                tracker =>
                    Number(tracker.battery)
            )

            .filter(
                value =>
                    !Number.isNaN(value)
            );

    let averageBattery = 0;

    if (batteries.length > 0) {

        averageBattery =
            batteries.reduce(
                (sum, value) =>
                    sum + value,
                0
            ) / batteries.length;
    }

    const totalElement =
        document.getElementById(
            "total-trackers"
        );

    const onlineElement =
        document.getElementById(
            "online-trackers"
        );

    const batteryElement =
        document.getElementById(
            "average-battery"
        );

    if (totalElement) {

        totalElement.textContent =
            total;
    }

    if (onlineElement) {

        onlineElement.textContent =
            online;
    }

    if (batteryElement) {

        batteryElement.textContent =
            `${Math.round(averageBattery)}%`;
    }
}


// ======================================================
// GET VALID TRACKER LOCATIONS
// ======================================================

function getValidTrackers(trackers) {

    if (!Array.isArray(trackers)) {
        return [];
    }

    return trackers.filter(tracker => {

        if (
            tracker.latitude === null ||
            tracker.latitude === undefined ||
            tracker.longitude === null ||
            tracker.longitude === undefined
        ) {
            return false;
        }

        const latitude =
            Number(tracker.latitude);

        const longitude =
            Number(tracker.longitude);

        return (
            !Number.isNaN(latitude) &&
            !Number.isNaN(longitude) &&
            latitude >= -90 &&
            latitude <= 90 &&
            longitude >= -180 &&
            longitude <= 180
        );
    });
}


// ======================================================
// UPDATE DASHBOARD MAP
// ======================================================

function updateDashboardMap(trackers) {

    if (!map) {
        return;
    }

    const validTrackers =
        getValidTrackers(trackers);

    const activeDeviceIds =
        new Set();

    validTrackers.forEach(tracker => {

        const deviceId =
            tracker.device_id;

        if (!deviceId) {
            return;
        }

        activeDeviceIds.add(deviceId);

        const latitude =
            Number(tracker.latitude);

        const longitude =
            Number(tracker.longitude);

        const position =
            [latitude, longitude];

        // ----------------------------------------------
        // UPDATE EXISTING MARKER
        // ----------------------------------------------

        if (markers[deviceId]) {

            markers[deviceId].setLatLng(
                position
            );

            markers[deviceId].setIcon(
                createTrackerIcon(tracker)
            );

            markers[deviceId].setPopupContent(
                createTrackerPopup(tracker)
            );

            return;
        }

        // ----------------------------------------------
        // CREATE NEW MARKER
        // ----------------------------------------------

        const marker =
            L.marker(
                position,
                {
                    icon:
                        createTrackerIcon(tracker)
                }
            ).addTo(map);

        marker.bindPopup(
            createTrackerPopup(tracker),
            {
                maxWidth: 320
            }
        );

        markers[deviceId] =
            marker;
    });

    // ----------------------------------------------
    // REMOVE OLD MARKERS
    // ----------------------------------------------

    Object.keys(markers).forEach(
        deviceId => {

            if (
                !activeDeviceIds.has(
                    deviceId
                )
            ) {

                map.removeLayer(
                    markers[deviceId]
                );

                delete markers[deviceId];
            }
        }
    );
}


// ======================================================
// UPDATE FULL MAP
// ======================================================

function updateFullMap(trackers) {

    if (!fullMap) {
        return;
    }

    const validTrackers =
        getValidTrackers(trackers);

    const activeDeviceIds =
        new Set();

    validTrackers.forEach(tracker => {

        const deviceId =
            tracker.device_id;

        if (!deviceId) {
            return;
        }

        activeDeviceIds.add(deviceId);

        const latitude =
            Number(tracker.latitude);

        const longitude =
            Number(tracker.longitude);

        const position =
            [latitude, longitude];

        // ----------------------------------------------
        // UPDATE EXISTING MARKER
        // ----------------------------------------------

        if (fullMapMarkers[deviceId]) {

            fullMapMarkers[deviceId]
                .setLatLng(position);

            fullMapMarkers[deviceId]
                .setIcon(
                    createTrackerIcon(tracker)
                );

            fullMapMarkers[deviceId]
                .setPopupContent(
                    createTrackerPopup(tracker)
                );

            return;
        }

        // ----------------------------------------------
        // CREATE NEW MARKER
        // ----------------------------------------------

        const marker =
            L.marker(
                position,
                {
                    icon:
                        createTrackerIcon(tracker)
                }
            ).addTo(fullMap);

        marker.bindPopup(
            createTrackerPopup(tracker),
            {
                maxWidth: 340
            }
        );

        fullMapMarkers[deviceId] =
            marker;
    });

    // ----------------------------------------------
    // REMOVE OLD MARKERS
    // ----------------------------------------------

    Object.keys(fullMapMarkers).forEach(
        deviceId => {

            if (
                !activeDeviceIds.has(
                    deviceId
                )
            ) {

                fullMap.removeLayer(
                    fullMapMarkers[deviceId]
                );

                delete fullMapMarkers[deviceId];
            }
        }
    );
}


// ======================================================
// TRACKER POPUP
// ======================================================

function createTrackerPopup(tracker) {

    const name =
        tracker.name ||
        tracker.device_id ||
        "Unknown Tracker";

    const deviceId =
        tracker.device_id ||
        "N/A";

    const status =
        tracker.status ||
        "unknown";

    const battery =
        tracker.battery !== null &&
        tracker.battery !== undefined
            ? `${tracker.battery}%`
            : "N/A";

    const latitude =
        tracker.latitude !== null &&
        tracker.latitude !== undefined
            ? tracker.latitude
            : "N/A";

    const longitude =
        tracker.longitude !== null &&
        tracker.longitude !== undefined
            ? tracker.longitude
            : "N/A";

    const gps =
        tracker.gps_status ||
        "unknown";

    const wifi =
        tracker.wifi_status ||
        "unknown";

    return `
        <div class="tracker-popup">

            <h3>
                ${escapeHtml(name)}
            </h3>

            <p>
                <strong>Device ID:</strong>
                ${escapeHtml(deviceId)}
            </p>

            <p>
                <strong>Status:</strong>
                ${escapeHtml(status)}
            </p>

            <p>
                <strong>Battery:</strong>
                ${escapeHtml(battery)}
            </p>

            <p>
                <strong>Latitude:</strong>
                ${escapeHtml(latitude)}
            </p>

            <p>
                <strong>Longitude:</strong>
                ${escapeHtml(longitude)}
            </p>

            <p>
                <strong>GPS:</strong>
                ${escapeHtml(gps)}
            </p>

            <p>
                <strong>Wi-Fi:</strong>
                ${escapeHtml(wifi)}
            </p>

        </div>
    `;
}


// ======================================================
// TRACKER MANAGEMENT PAGE
// ======================================================
function displayTrackerManagement(trackers) {
    const container = document.getElementById(
        "tracker-management-list"
    );

    if (!container) {
        return;
    }

    if (!trackers || trackers.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <div class="empty-icon">🛡</div>
                <h3>No trackers found</h3>
                <p>Add a safety tracker to start monitoring.</p>
            </div>
        `;
        return;
    }

    container.innerHTML = "";

    trackers.forEach(tracker => {
        const item = document.createElement("div");

        item.className = "modern-tracker-card";

        const name =
            tracker.name ||
            tracker.device_id ||
            "Unnamed Tracker";

        const deviceId =
            tracker.device_id ||
            "N/A";

        const assignedPerson =
            tracker.assigned_person ||
            "Not assigned";

        const phone =
            tracker.phone ||
            "Not available";

        const status =
            String(tracker.status || "offline").toLowerCase();

        const batteryValue =
            tracker.battery !== null &&
            tracker.battery !== undefined
                ? Number(tracker.battery)
                : 0;

        const battery =
            Math.max(
                0,
                Math.min(100, batteryValue)
            );

        const gps =
            tracker.gps_status ||
            "unknown";

        const wifi =
            tracker.wifi_status ||
            "unknown";

        const latitude =
            tracker.latitude !== null &&
            tracker.latitude !== undefined
                ? Number(tracker.latitude).toFixed(5)
                : "N/A";

        const longitude =
            tracker.longitude !== null &&
            tracker.longitude !== undefined
                ? Number(tracker.longitude).toFixed(5)
                : "N/A";

        const accuracy =
            tracker.accuracy !== null &&
            tracker.accuracy !== undefined
                ? `${tracker.accuracy} m`
                : "N/A";

        const lastUpdate =
            tracker.telemetry_timestamp ||
            tracker.updated_at ||
            null;

        let lastUpdateText = "No telemetry";

        if (lastUpdate) {
            const date = new Date(lastUpdate);

            if (!isNaN(date.getTime())) {
                lastUpdateText =
                    date.toLocaleString();
            }
        }

        const statusLabel =
            status === "online"
                ? "Online"
                : "Offline";

        const statusClass =
            status === "online"
                ? "online"
                : "offline";

        let batteryClass = "good";

        if (battery <= 20) {
            batteryClass = "critical";
        } else if (battery <= 50) {
            batteryClass = "warning";
        }

        const gpsClass =
            String(gps).toLowerCase() === "active" ||
            String(gps).toLowerCase() === "connected" ||
            String(gps).toLowerCase() === "ok"
                ? "connected"
                : "disconnected";

        const wifiClass =
            String(wifi).toLowerCase() === "connected" ||
            String(wifi).toLowerCase() === "active" ||
            String(wifi).toLowerCase() === "ok"
                ? "connected"
                : "disconnected";

        const sosClass =
            tracker.sos
                ? "sos-active"
                : "sos-safe";

        const sosText =
            tracker.sos
                ? "SOS ACTIVE"
                : "Safe";

        item.innerHTML = `
            <div class="modern-tracker-header">

                <div class="tracker-identity">

                    <div class="tracker-avatar">
                        🛡
                    </div>

                    <div>
                        <h3>
                            ${escapeHtml(name)}
                        </h3>

                        <span class="tracker-device-id">
                            ${escapeHtml(deviceId)}
                        </span>
                    </div>

                </div>

                <div class="
                    tracker-status
                    ${statusClass}
                ">
                    <span class="status-dot"></span>
                    ${statusLabel}
                </div>

            </div>


            <div class="tracker-person">

                <div class="person-info">

                    <span class="detail-label">
                        Assigned to
                    </span>

                    <strong>
                        ${escapeHtml(
                            assignedPerson
                        )}
                    </strong>

                </div>

                <div class="person-info">

                    <span class="detail-label">
                        Phone
                    </span>

                    <strong>
                        ${escapeHtml(phone)}
                    </strong>

                </div>

            </div>


            <div class="tracker-battery">

                <div class="battery-header">

                    <span>
                        Battery
                    </span>

                    <strong>
                        ${battery}%
                    </strong>

                </div>

                <div class="battery-track">

                    <div
                        class="
                            battery-fill
                            ${batteryClass}
                        "
                        style="
                            width: ${battery}%;
                        "
                    ></div>

                </div>

            </div>


            <div class="tracker-metrics">

                <div class="tracker-metric">

                    <div class="metric-icon">
                        📍
                    </div>

                    <div>
                        <span>
                            GPS
                        </span>

                        <strong class="${gpsClass}">
                            ${escapeHtml(gps)}
                        </strong>
                    </div>

                </div>


                <div class="tracker-metric">

                    <div class="metric-icon">
                        📶
                    </div>

                    <div>
                        <span>
                            Wi-Fi
                        </span>

                        <strong class="${wifiClass}">
                            ${escapeHtml(wifi)}
                        </strong>
                    </div>

                </div>


                <div class="tracker-metric">

                    <div class="metric-icon">
                        ⚠
                    </div>

                    <div>
                        <span>
                            Safety
                        </span>

                        <strong class="${sosClass}">
                            ${sosText}
                        </strong>
                    </div>

                </div>

            </div>


            <div class="tracker-location">

                <div class="location-header">

                    <span>
                        📍 Latest Location
                    </span>

                    <span>
                        Accuracy:
                        ${escapeHtml(accuracy)}
                    </span>

                </div>

                <div class="coordinates">

                    <div>
                        <small>
                            Latitude
                        </small>

                        <strong>
                            ${escapeHtml(latitude)}
                        </strong>
                    </div>

                    <div>
                        <small>
                            Longitude
                        </small>

                        <strong>
                            ${escapeHtml(longitude)}
                        </strong>
                    </div>

                </div>

            </div>


            <div class="tracker-footer">

                <span class="last-update">
                    Last update:
                    ${escapeHtml(lastUpdateText)}
                </span>

                <button
                    type="button"
                    class="tracker-view-button"
                    data-device-id="${escapeHtml(
                        deviceId
                    )}"
                >
                    View on Map
                    <span>→</span>
                </button>

            </div>
        `;

        container.appendChild(item);
    });


    /*
     * View on Map buttons
     */

    const mapButtons =
        container.querySelectorAll(
            ".tracker-view-button"
        );

    mapButtons.forEach(button => {

        button.addEventListener(
            "click",
            () => {

                const deviceId =
                    button.dataset.deviceId;

                if (!deviceId) {
                    return;
                }

                const tracker =
                    trackers.find(
                        item =>
                            String(
                                item.device_id
                            ) ===
                            String(deviceId)
                    );

                if (!tracker) {
                    return;
                }

                showPage("map");

                setTimeout(() => {

                    if (
                        fullMap &&
                        tracker.latitude !== null &&
                        tracker.longitude !== null
                    ) {

                        const lat =
                            Number(
                                tracker.latitude
                            );

                        const lng =
                            Number(
                                tracker.longitude
                            );

                        if (
                            !isNaN(lat) &&
                            !isNaN(lng)
                        ) {

                            fullMap.setView(
                                [lat, lng],
                                16
                            );

                            const marker =
                                fullMapMarkers[
                                    deviceId
                                ];

                            if (marker) {
                                marker.openPopup();
                            }
                        }
                    }

                }, 300);
            }
        );
    });
}
// ======================================================
// LOAD ALERTS
// ======================================================

async function loadAlerts() {

    try {

        const response =
            await fetch(
                `${API_BASE}/alerts`
            );

        if (!response.ok) {
            throw new Error(
                "Failed to load alerts"
            );
        }

        const alerts =
            await response.json();

        updateAlertCount(alerts);

        displayAllAlerts(alerts);

    } catch (error) {

        console.error(
            "Alert loading error:",
            error
        );
    }
}


// ======================================================
// ALERT COUNT
// ======================================================

function updateAlertCount(alerts) {

    if (!Array.isArray(alerts)) {
        return;
    }

    const activeAlerts =
        alerts.filter(
            alert =>
                alert.status &&
                alert.status.toLowerCase() ===
                    "active"
        ).length;

    const element =
        document.getElementById(
            "active-alerts"
        );

    if (element) {
        element.textContent =
            activeAlerts;
    }
}


