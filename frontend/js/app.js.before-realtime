// ======================================================
// DISPLAY ALL ALERTS
// ======================================================

function displayAllAlerts(alerts) {

    const container =
        document.getElementById("all-alerts-list");

    if (!container) {
        return;
    }

    if (!alerts || alerts.length === 0) {

        container.innerHTML = `
            <div class="empty-state">
                <div style="font-size: 32px; margin-bottom: 10px;">
                    ✓
                </div>

                <strong>No safety alerts</strong>

                <p>
                    Everything looks safe right now.
                </p>
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    alerts.forEach(alert => {

        const status =
            String(alert.status || "active").toLowerCase();

        const isResolved =
            status === "resolved";

        const alertType =
            alert.alert_type || "Safety Alert";

        const message =
            alert.message || "Safety event detected";

        const deviceId =
            alert.device_id || "Unknown device";

        const latitude =
            alert.latitude !== null &&
            alert.latitude !== undefined
                ? Number(alert.latitude).toFixed(6)
                : "N/A";

        const longitude =
            alert.longitude !== null &&
            alert.longitude !== undefined
                ? Number(alert.longitude).toFixed(6)
                : "N/A";

        let createdAt = "Unknown time";

        if (alert.created_at) {

            const date =
                new Date(alert.created_at);

            if (!isNaN(date.getTime())) {

                createdAt =
                    date.toLocaleString(
                        undefined,
                        {
                            dateStyle: "medium",
                            timeStyle: "short"
                        }
                    );
            }
        }

        const item =
            document.createElement("div");

        item.className =
            `alert-card ${isResolved ? "alert-resolved" : "alert-active"}`;

        item.innerHTML = `

            <div class="alert-card-main">

                <div class="alert-card-icon">
                    ${isResolved ? "✓" : "!"}
                </div>

                <div class="alert-card-content">

                    <div class="alert-card-header">

                        <div>

                            <span class="alert-type">
                                ${escapeHtml(alertType)}
                            </span>

                            <h3>
                                ${escapeHtml(message)}
                            </h3>

                        </div>

                        <span class="alert-status-badge
                            ${isResolved ? "resolved" : "active"}">

                            ${isResolved
                                ? "Resolved"
                                : "Active"}

                        </span>

                    </div>

                    <div class="alert-card-details">

                        <div class="alert-detail">

                            <span class="detail-label">
                                Device
                            </span>

                            <strong>
                                ${escapeHtml(deviceId)}
                            </strong>

                        </div>

                        <div class="alert-detail">

                            <span class="detail-label">
                                Location
                            </span>

                            <strong>
                                ${escapeHtml(latitude)},
                                ${escapeHtml(longitude)}
                            </strong>

                        </div>

                        <div class="alert-detail">

                            <span class="detail-label">
                                Created
                            </span>

                            <strong>
                                ${escapeHtml(createdAt)}
                            </strong>

                        </div>

                    </div>

                    <div class="alert-card-actions">

                        ${
                            !isResolved
                                ? `
                                    <button
                                        type="button"
                                        class="resolve-alert-button"
                                        data-alert-id="${alert.id}"
                                    >
                                        ✓ Resolve Alert
                                    </button>
                                  `
                                : `
                                    <span class="resolved-message">
                                        ✓ Alert resolved
                                    </span>
                                  `
                        }

                        ${
                            alert.latitude !== null &&
                            alert.latitude !== undefined &&
                            alert.longitude !== null &&
                            alert.longitude !== undefined
                                ? `
                                    <button
                                        type="button"
                                        class="view-location-button"
                                        data-lat="${alert.latitude}"
                                        data-lng="${alert.longitude}"
                                    >
                                        ⌖ View Location
                                    </button>
                                  `
                                : ""
                        }

                    </div>

                </div>

            </div>
        `;

        container.appendChild(item);
    });

    // ==================================================
    // RESOLVE ALERT BUTTONS
    // ==================================================

    const resolveButtons =
        container.querySelectorAll(
            ".resolve-alert-button"
        );

    resolveButtons.forEach(button => {

        button.addEventListener(
            "click",
            async () => {

                const alertId =
                    button.dataset.alertId;

                if (!alertId) {
                    return;
                }

                const originalText =
                    button.textContent;

                button.disabled = true;

                button.textContent =
                    "Resolving...";

                try {

                    const response =
                        await fetch(
                            `${API_BASE}/alerts/${encodeURIComponent(alertId)}/resolve`,
                            {
                                method: "POST"
                            }
                        );

                    if (!response.ok) {

                        const errorData =
                            await response.json()
                                .catch(() => ({}));

                        throw new Error(
                            errorData.error ||
                            "Failed to resolve alert"
                        );
                    }

                    await loadAlerts();

                } catch (error) {

                    console.error(
                        "Resolve alert error:",
                        error
                    );

                    button.disabled = false;

                    button.textContent =
                        originalText;

                    alert(
                        "Unable to resolve this alert."
                    );
                }
            }
        );
    });

    // ==================================================
    // VIEW LOCATION BUTTONS
    // ==================================================

    const locationButtons =
        container.querySelectorAll(
            ".view-location-button"
        );

    locationButtons.forEach(button => {

        button.addEventListener(
            "click",
            () => {

                const latitude =
                    parseFloat(button.dataset.lat);

                const longitude =
                    parseFloat(button.dataset.lng);

                if (
                    Number.isNaN(latitude) ||
                    Number.isNaN(longitude)
                ) {
                    return;
                }

                // Open the Live Map page
                showPage("map");

                setTimeout(() => {

                    if (fullMap) {

                        fullMap.setView(
                            [latitude, longitude],
                            17
                        );

                        fullMap.invalidateSize();

                    }

                }, 300);
            }
        );
    });
}

// ======================================================
// HISTORY - LOAD TRACKERS
// ======================================================

async function loadHistoryTrackers() {

    const container =
        document.getElementById(
            "history-list"
        );

    if (!container) {
        return;
    }

    container.innerHTML = `
        <div class="empty-state">
            Loading trackers...
        </div>
    `;

    try {

        const response =
            await fetch(
                `${API_BASE}/trackers`
            );

        if (!response.ok) {
            throw new Error(
                "Failed to load trackers"
            );
        }

        const trackers =
            await response.json();

        if (
            !trackers ||
            trackers.length === 0
        ) {

            container.innerHTML = `
                <div class="empty-state">
                    No trackers available.
                </div>
            `;

            return;
        }

        let html = `

            <div class="history-controls">

                <label
                    for="history-tracker-select"
                >
                    Select Tracker
                </label>

                <select
                    id="history-tracker-select"
                >

                    <option value="">
                        Select a tracker
                    </option>
        `;

        trackers.forEach(tracker => {

            html += `
                <option
                    value="${escapeHtml(
                        tracker.device_id
                    )}"
                >
                    ${escapeHtml(
                        tracker.name ||
                        tracker.device_id
                    )}
                    -
                    ${escapeHtml(
                        tracker.device_id
                    )}
                </option>
            `;
        });

        html += `

                </select>

                <button
                    type="button"
                    class="refresh-button"
                    id="history-refresh-button"
                >
                    Refresh
                </button>

            </div>

            <div
                id="history-table-container"
            >

                <div class="empty-state">
                    Select a tracker to view
                    telemetry history.
                </div>

            </div>
        `;

        container.innerHTML = html;

        const selector =
            document.getElementById(
                "history-tracker-select"
            );

        if (selector) {

            selector.addEventListener(
                "change",
                () => {

                    if (selector.value) {

                        loadHistory(
                            selector.value
                        );

                    } else {

                        const tableContainer =
                            document.getElementById(
                                "history-table-container"
                            );

                        if (tableContainer) {

                            tableContainer.innerHTML = `
                                <div class="empty-state">
                                    Select a tracker to view
                                    telemetry history.
                                </div>
                            `;
                        }
                    }
                }
            );
        }

        const refreshButton =
            document.getElementById(
                "history-refresh-button"
            );

        if (refreshButton) {

            refreshButton.addEventListener(
                "click",
                loadHistoryTrackers
            );
        }

    } catch (error) {

        console.error(
            "History tracker loading error:",
            error
        );

        container.innerHTML = `
            <div class="empty-state">
                Failed to load trackers.
            </div>
        `;
    }
}


// ======================================================
// HISTORY - LOAD TELEMETRY
// ======================================================

async function loadHistory(deviceId) {

    const container =
        document.getElementById(
            "history-table-container"
        );

    if (!container) {
        return;
    }

    container.innerHTML = `
        <div class="empty-state">
            Loading telemetry history...
        </div>
    `;

    try {

        const response =
            await fetch(
                `${API_BASE}/telemetry/${encodeURIComponent(
                    deviceId
                )}`
            );

        if (!response.ok) {
            throw new Error(
                "Failed to load telemetry"
            );
        }

        const telemetry =
            await response.json();

        if (
            !telemetry ||
            telemetry.length === 0
        ) {

            container.innerHTML = `
                <div class="empty-state">
                    No telemetry records found
                    for this tracker.
                </div>
            `;

            return;
        }

        let html = `

            <div class="history-table-wrapper">

                <table class="history-table">

                    <thead>

                        <tr>

                            <th>Date / Time</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                            <th>Accuracy</th>
                            <th>Battery</th>
                            <th>GPS</th>
                            <th>Wi-Fi</th>
                            <th>SOS</th>

                        </tr>

                    </thead>

                    <tbody>
        `;

        telemetry.forEach(record => {

            const timestamp =
                formatDateTime(
                    record.timestamp
                );

            const latitude =
                record.latitude !== null &&
                record.latitude !== undefined
                    ? record.latitude
                    : "N/A";

            const longitude =
                record.longitude !== null &&
                record.longitude !== undefined
                    ? record.longitude
                    : "N/A";

            const accuracy =
                record.accuracy !== null &&
                record.accuracy !== undefined
                    ? `${record.accuracy} m`
                    : "N/A";

            const battery =
                record.battery !== null &&
                record.battery !== undefined
                    ? `${record.battery}%`
                    : "N/A";

            const gps =
                record.gps_status ||
                "unknown";

            const wifi =
                record.wifi_status ||
                "unknown";

            const sos =
                record.sos
                    ? "🚨 YES"
                    : "No";

            html += `

                <tr>

                    <td>
                        ${escapeHtml(
                            timestamp
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            latitude
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            longitude
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            accuracy
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            battery
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            gps
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            wifi
                        )}
                    </td>

                    <td class="${
                        record.sos
                            ? "sos-active"
                            : ""
                    }">

                        ${sos}

                    </td>

                </tr>
            `;
        });

        html += `

                    </tbody>

                </table>

            </div>
        `;

        container.innerHTML = html;

    } catch (error) {

        console.error(
            "Telemetry history error:",
            error
        );

        container.innerHTML = `
            <div class="empty-state">
                Failed to load telemetry history.
            </div>
        `;
    }
}


// ======================================================
// DATE / TIME FORMATTER
// ======================================================

function formatDateTime(value) {

    if (!value) {
        return "N/A";
    }

    try {

        const date =
            new Date(value);

        if (
            Number.isNaN(
                date.getTime()
            )
        ) {
            return value;
        }

        return date.toLocaleString(
            "en-IN",
            {
                dateStyle: "medium",
                timeStyle: "medium"
            }
        );

    } catch {
        return value;
    }
}


// ======================================================
// PAGE NAVIGATION
// ======================================================

function showPage(pageName) {

    const pages =
        document.querySelectorAll(
            ".page-content"
        );

    const navItems =
        document.querySelectorAll(
            ".nav-item[data-page]"
        );

    // Hide every page
    pages.forEach(page => {
        page.classList.add("hidden");
    });

    // Remove active navigation state
    navItems.forEach(item => {
        item.classList.remove("active");
    });

    // Show selected page
    const selectedPage =
        document.getElementById(
            `page-${pageName}`
        );

    if (selectedPage) {

        selectedPage.classList.remove(
            "hidden"
        );
    }

    // Activate selected navigation item
    const selectedNav =
        document.querySelector(
            `.nav-item[data-page="${pageName}"]`
        );

    if (selectedNav) {

        selectedNav.classList.add(
            "active"
        );
    }

    // ==================================================
    // TOP BAR
    // ==================================================

    const titles = {

        dashboard:
            "Dashboard",

        trackers:
            "Tracker Management",

        map:
            "Live Map",

        alerts:
            "Safety Alerts",

        history:
            "Telemetry History"
    };

    const descriptions = {

        dashboard:
            "Real-time safety monitoring",

        trackers:
            "Monitor all registered IoT safety trackers.",

        map:
            "Real-time location of all active trackers.",

        alerts:
            "Monitor active and historical safety events.",

        history:
            "Historical GPS and tracker telemetry data."
    };

    const titleElement =
        document.querySelector(
            ".topbar h2"
        );

    const descriptionElement =
        document.querySelector(
            ".topbar p"
        );

    if (titleElement) {

        titleElement.textContent =
            titles[pageName] ||
            "Dashboard";
    }

    if (descriptionElement) {

        descriptionElement.textContent =
            descriptions[pageName] ||
            "Real-time safety monitoring";
    }

    // ==================================================
    // PAGE-SPECIFIC ACTIONS
    // ==================================================

    if (pageName === "dashboard") {

        setTimeout(() => {

            if (map) {
                map.invalidateSize();
            }

            loadTrackers();

        }, 100);
    }

    if (pageName === "trackers") {

        loadTrackers();
    }

    if (pageName === "map") {

        initializeFullMap();

        setTimeout(() => {

            if (fullMap) {

                fullMap.invalidateSize();
            }

            loadTrackers();

        }, 200);
    }

    if (pageName === "alerts") {

        loadAlerts();
    }

    if (pageName === "history") {

        loadHistoryTrackers();
    }
}


// ======================================================
// NAVIGATION EVENTS
// ======================================================

function initializeNavigation() {

    const navItems =
        document.querySelectorAll(
            ".nav-item[data-page]"
        );

    navItems.forEach(button => {

        button.addEventListener(
            "click",
            () => {

                const page =
                    button.dataset.page;

                if (page) {

                    showPage(page);
                }
            }
        );
    });
}


